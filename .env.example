NEXT_PUBLIC_EVENTBRITE_URL=https://www.eventbrite.com/e/ksigdillas-tickets-1992696425651?aff=oddtdtcreator
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/placeholder
NEXT_PUBLIC_CONTACT_EMAIL=ksigdillas@example.com

# Server-only. Never prefix this value with NEXT_PUBLIC_.
ADMIN_PASSCODE=replace-with-a-long-random-passcode

# Optional persistent leaderboard storage. When omitted, local JSON is used.
DATABASE_URL=

# Server-only Eventbrite leaderboard sync.
EVENTBRITE_SYNC_ENABLED=true
EVENTBRITE_EVENT_ID=1992696425651
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_TEAM_QUESTION=Which sorority or team are you supporting?
EVENTBRITE_SYNC_MIN_SECONDS=60

# Optional local JSON location. Defaults to .data/leaderboard.json.
# LEADERBOARD_DATA_PATH=/absolute/path/to/leaderboard.json

# New event desk is opt-in. Keep legacy live data isolated until reviewed cutover.
EVENT_OPERATIONS_ENABLED=false
OPERATIONS_DATABASE_URL=
APP_URL=http://127.0.0.1:3100
# 32 random bytes encoded as 64 hex characters; server-only, preserve for recovery.
TICKET_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# Prefer Brevo's free tier; Resend remains supported. EMAIL_FROM must be a verified
# bare email address for Brevo. Reply-to stays zachzapalac@gmail.com.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_DAILY_LIMIT=300
# Configure this as x-ksigdillas-webhook-secret on Brevo's transactional webhook.
EMAIL_WEBHOOK_SECRET=
# Authenticates POST /api/jobs from an external scheduler. Minimum 32 characters.
MAINTENANCE_JOB_SECRET=
# Independent monitoring: a separate random 32+ character read-only health token.
# Use GET /api/jobs?health=true&strict=true with an Authorization Bearer header.
MONITORING_HEALTH_SECRET=
# Vercel Cron only: provision this with the SAME value as MAINTENANCE_JOB_SECRET.
CRON_SECRET=
# Stripe API 2026-10-28.endive; test/live settings must match and stay isolated.
# Keep new sales closed until account, fee policy, services and device checks pass.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Existing local files may instead use STRIPE_SECRET, STRIPE_WEBHOOK and
# STRIPE_PUBLISHABLE; the integration accepts those aliases server-side.
# Publishable key is intentionally public; all other Stripe credentials are server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_MEAT=
STRIPE_PRICE_BASIC_DOOR=
STRIPE_PRICE_MEAT_DOOR=
# Buyer pays the fee. Approval means Stripe/account owner has confirmed a permitted
# arrangement for all enabled methods; a fee line item alone is not approval.
STRIPE_FEE_POLICY_APPROVED=false
STRIPE_FEE_POLICY_REFERENCE=
STRIPE_FEE_BASIS_POINTS=290
STRIPE_FEE_FIXED_CENTS=30
# Current organizer link: https://buy.stripe.com/6oU3cva1Ccbe4pY3lR2kw01
# Enable signed-event imports only after verifying account, link ID and price IDs.
STRIPE_PAYMENT_LINK_ENABLED=false
STRIPE_PAYMENT_LINK_ID=
# Separate fee-inclusive USD prices: Basic 1061 cents, Meat/Veggies 1576 cents.
STRIPE_LINK_PRICE_BASIC=
STRIPE_LINK_PRICE_MEAT=
STRIPE_CHAPTER_FIELD_KEY=chapter
STRIPE_SELLER_FIELD_KEY=soldby
# Test fixtures are never allowed in production. Leave disabled outside local tests.
OPS_ALLOW_TEST_FIXTURES=false

# Use observed fee-inclusive ticket prices. Never add another gross-up to them.
STRIPE_PRICING_MODE=all_in
# Keep owner-operated refunds unless write access was specifically granted.
STRIPE_REFUND_WRITE_ENABLED=false
# Launch evidence. References identify reviewed private records, not secrets.
EVENT_ORGANIZER_APPROVED=2026-11-03-v1
EVENT_APPROVAL_REFERENCE=
HOSTING_APPROVAL_REFERENCE=
EVENT_TAX_TREATMENT=
EVENT_TAX_REFERENCE=
DATA_RETENTION_APPROVED=
DATA_PAID_ANONYMIZATION_APPROVED=false
ASSET_RIGHTS_REFERENCE=
EMAIL_ACCEPTANCE_REFERENCE=
JOBS_ACCEPTANCE_REFERENCE=
PHONE_ACCEPTANCE_REFERENCE=
# Setup-only: your designated inbox; never an unsolicited buyer test.
EMAIL_TEST_TO=
# A restore must reapply prior deletion requests, even from an older backup.
PRIVACY_DELETION_MANIFEST=
# Native Netlify scheduler; enable only in the production environment context.
MAINTENANCE_ENABLED=false
